<div class="form-control">
  <%= f.label :role, class: 'label' %>
  <%# CCN fork: editor and viewer are implemented here (specs/003-p1-features, US3). The options are built as
      a list rather than a block: a block reaches options_for_select as a String, which it returns untouched,
      so the user's current role would never come back marked selected — and this form permits `role`, so
      editing an editor's surname would have saved them back as an admin. %>
  <%= f.select :role, User::ROLES.map { |role| [t(role), role] }, {}, class: 'base-select' %>
  <% if Docuseal.multitenant? %>
    <label class="label">
      <span class="label-text-alt">
        <%= t('click_here_to_learn_more_about_user_roles_and_permissions_html') %>
      </span>
    </label>
  <% end %>
</div>
